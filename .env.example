# Postgres. Local Docker for dev, Neon for production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/jlpt_local

# ---------------------------------------------------------------------------
# Cloudflare R2 — media (audio + choice images) lives here in production.
#
# All of this is OPTIONAL for local development. Leave R2_PUBLIC_URL blank and
# media is served from public/ instead, since storage keys mirror that layout.
# In production a missing R2_PUBLIC_URL is a hard error rather than a silent 404.
# ---------------------------------------------------------------------------

# Account ID and bucket from the Cloudflare dashboard; the key pair from
# R2 > Manage API Tokens (needs Object Read & Write on this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jlpt-media

# Public base URL for the bucket — r2.dev subdomain or custom domain.
# No trailing slash.
R2_PUBLIC_URL=
