# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# exam content: real test data, questions and audio stay local
/data/
/public/audio/
/public/images/exams/
/public/N1-*/
/public/n1_*
/vocab_fix_list.txt
/temp_library_data.tsx

# scripts: only generic tooling is tracked. The per-exam one-offs embed
# question text, answer keys and source links.
/scripts/*
!/scripts/_local-media.ts
!/scripts/check-db.ts
!/scripts/diag_db.ts
!/scripts/drop-file-bytea.ts
!/scripts/migrate-media-to-r2.ts
!/scripts/recover_json_from_db.ts
!/scripts/reset-db.ts
!/scripts/seed-audio.ts
!/scripts/seed-exam-data.ts
!/scripts/wipe_exam.js
